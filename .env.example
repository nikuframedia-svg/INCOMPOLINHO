# ─── PP1 Scheduler — environment ──────────────────────────────
# Copy this file to .env and fill in only what you need:
#     cp .env.example .env
#
# The scheduler, Gantt, simulator and all planning features work
# WITHOUT any of these. They are only needed by the AI copilot chat.

# LLM backend for the copilot: "openai" (default) or "ollama"
PP1_LLM_BACKEND=openai

# ── OpenAI (when PP1_LLM_BACKEND=openai) ──────────────────────
PP1_OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
PP1_OPENAI_MODEL=gpt-4o

# ── Ollama (when PP1_LLM_BACKEND=ollama) ──────────────────────
# Note: from inside the container, reach an Ollama running on the
# host via http://host.docker.internal:11434
# PP1_OLLAMA_URL=http://host.docker.internal:11434
# PP1_OLLAMA_MODEL=qwen2.5:14b
