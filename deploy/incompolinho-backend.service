[Unit]
Description=INCOMPOLINHO backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/luis/projects/INCOMPOLINHO
Environment=PYTHONHASHSEED=0
Environment=PYTHONDONTWRITEBYTECODE=1
# Live factory configuration lives with the data, outside git (19/10/2026).
Environment=PP1_CONFIG_PATH=/home/luis/projects/INCOMPOLINHO/data/factory.yaml
ExecStart=/home/luis/projects/INCOMPOLINHO/.venv/bin/python -m uvicorn backend.api.copilot:app --host 127.0.0.1 --port 8010 --log-config /home/luis/projects/INCOMPOLINHO/deploy/uvicorn-logging.json
Restart=always
RestartSec=2
StandardOutput=append:/home/luis/projects/INCOMPOLINHO/.run-logs/backend.log
StandardError=append:/home/luis/projects/INCOMPOLINHO/.run-logs/backend.log

[Install]
WantedBy=default.target
